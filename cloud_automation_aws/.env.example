PORT=3003
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=racko_cloud_automation_aws

AWS_REGION=ap-south-1
# Region where IAM Identity Center is enabled (often us-east-1 even if AWS_REGION differs)
AWS_SSO_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SSO_INSTANCE_ARN=
AWS_SSO_IDENTITY_STORE_ID=
MASTER_ACCOUNT_ID=
AWS_ORGANIZATION_ROOT_ID=
AWS_LABS_OU_ID=
AWS_SANDBOX_OU_ID=
AWS_PRODUCTION_OU_ID=
AWS_DEFAULT_OU=Labs
AWS_IDENTITY_CENTER_START_URL=

# Set to false to skip Organizations SCP and rely on permission sets only
ENABLE_SCP_RESTRICTIONS=true

ACCOUNT_CREATION_TIMEOUT_MS=1200000
ACCOUNT_CREATION_POLL_MS=15000
ACCOUNT_CREATION_MAX_RETRIES=5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CLIENT_PORTAL_URL=http://localhost:3000
# JWT secret for manage portal sessions and console access tokens
PROVISION_ACCESS_TOKEN_SECRET=

ENABLE_CATALOG_SCHEDULER=true
CATALOG_SYNC_CRON=0 2 * * *

# Access type defaults
DEFAULT_ACCESS_TYPE=magic_link
MAGIC_LINK_SESSION_HOURS=12

# Cross-account role used to create IAM users in lab accounts (long-lab path)
RACKO_LAB_ADMIN_ROLE_NAME=RackoLabAdmin
EXPIRY_CHECK_INTERVAL_MINS=60

# Session tracking
SESSION_EXPIRE_CHECK_INTERVAL_MINS=1
# End usage sessions when no CloudTrail activity for this many minutes (default 5)
AWS_SESSION_IDLE_MINUTES=5
AWS_SIGNIN_MONITOR_LOOKBACK_MINUTES=60

# Cost tracking
COST_EXPLORER_ENABLED=true
BUDGET_POLL_INTERVAL_MINUTES=15

# Cleanup
CLEANUP_CHECK_INTERVAL_MINS=5
