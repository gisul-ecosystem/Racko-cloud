# App
PORT=3004
NODE_ENV=development

# GCP Core
GCP_PROJECT_ID=your-master-project-id
GCP_ORGANIZATION_ID=123456789012
GCP_BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX
GCP_FOLDER_ID=

# GCP Auth — service account key file path
GCP_SERVICE_ACCOUNT_KEY_PATH=./gcp-key.json

# GCP Domain (for Cloud Identity users)
GCP_DOMAIN=yourdomain.com

# GCP Identity (Admin SDK for Cloud Identity users)
GCP_ADMIN_EMAIL=admin@yourdomain.com

# GCP Region defaults
GCP_DEFAULT_REGION=asia-south1
GCP_DEFAULT_ZONE=asia-south1-a

# MongoDB (shared with main project)
MONGODB_URI=
MONGODB_DB_NAME=iaas_platform

# Manage portal
CLIENT_PORTAL_URL=http://localhost:3000
PROVISION_ACCESS_TOKEN_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
