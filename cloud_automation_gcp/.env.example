# App
PORT=3004
NODE_ENV=development

# GCP core (add when sir sends credentials)
GCP_PROJECT_ID=
GCP_ORGANIZATION_ID=
GCP_BILLING_ACCOUNT_ID=
GCP_FOLDER_ID=
GCP_SERVICE_ACCOUNT_KEY_PATH=./gcp-key.json
GCP_DOMAIN=
GCP_ADMIN_EMAIL=

# Defaults
GCP_DEFAULT_REGION=asia-south1
GCP_DEFAULT_ZONE=asia-south1-a
GCP_LAB_PROJECT_PREFIX=racko-lab

# Database (Atlas)
MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=...&authSource=admin
MONGODB_DB_NAME=iaas_platform

# GCP pricing API (optional — uses seeded rates until set)
# Cloud Billing Catalog: https://cloudbilling.googleapis.com/v1/services/6F81-5844-456A/skus
GCP_API_KEY=

# Portal
CLIENT_PORTAL_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email (Phase 2)
RESEND_EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Racko
