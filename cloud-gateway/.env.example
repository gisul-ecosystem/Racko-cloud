NODE_ENV=production
PORT=8000

# Core API URL
CORE_API_URL=http://localhost:8001

# Cloud automation service (Azure access management)
CLOUD_AUTOMATION_URL=http://localhost:3000

# JWT (must match core-api)
JWT_ACCESS_SECRET=<minimum-64-char-random-string-same-as-core-api>
JWT_ACCESS_EXPIRES_IN=15m

# CORS
ALLOWED_ORIGINS=https://yourdomain.com

# Request timeout
REQUEST_TIMEOUT_MS=10000

# Rate limiting (window = 15 minutes by default)
RATE_LIMIT_WINDOW_MS=900000
# Auth routes: failed attempts only per IP (2xx responses do not count) — separate buckets
RATE_LIMIT_LOGIN_FAILED_MAX=50
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_VERIFY_EMAIL_MAX=10
RATE_LIMIT_USER_MAX=500

# Internal service secret (must match core-api)
INTERNAL_SERVICE_SECRET=<minimum-64-char-random-string-same-as-core-api>
