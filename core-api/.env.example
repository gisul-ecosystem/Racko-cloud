NODE_ENV=production
PORT=8001

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=iaas_platform

# JWT
JWT_ACCESS_SECRET=<minimum-64-char-random-string-change-this-in-production-use-openssl-rand-hex-64>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<different-64-char-random-string-change-this-in-production-use-openssl-rand-hex-64>
JWT_REFRESH_EXPIRES_IN=7d

# Argon2id (OWASP recommended minimums)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=YourPlatformName

# Frontend
FRONTEND_URL=https://yourdomain.com

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# Email verification
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Super admin seed (used by seed script only)
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=<strong-password-min-16-chars>

# Internal service secret (gateway → core-api)
INTERNAL_SERVICE_SECRET=<minimum-64-char-random-string-for-internal-service-auth>

# Proxmox Configuration
PROXMOX_HOST=https://your-proxmox-ip:8006
PROXMOX_TOKEN_ID=root@pam!iaas-platform
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Set to false for self-signed certs (common in private Proxmox setups)
# Set to true in production with a valid SSL certificate
PROXMOX_VERIFY_SSL=false
