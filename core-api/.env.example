NODE_ENV=production
PORT=8001

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=iaas_platform

# JWT
JWT_ACCESS_SECRET=<minimum-64-char-random-string-change-this-in-production-use-openssl-rand-hex-64>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<different-64-char-random-string-change-this-in-production-use-openssl-rand-hex-64>
JWT_REFRESH_EXPIRES_IN=7d

# Argon2id (OWASP recommended minimums)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=YourPlatformName

# Frontend
FRONTEND_URL=https://yourdomain.com

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# Email verification
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Super admin seed (used by seed script only)
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=<strong-password-min-16-chars>

# Internal service secret (gateway → core-api)
INTERNAL_SERVICE_SECRET=<minimum-64-char-random-string-for-internal-service-auth>

# Proxmox Configuration
PROXMOX_HOST=https://your-proxmox-ip:8006
PROXMOX_TOKEN_ID=root@pam!iaas-platform
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Set to false for self-signed certs (common in private Proxmox setups)
# Set to true in production with a valid SSL certificate
PROXMOX_VERIFY_SSL=false

# ─── VM Configuration ─────────────────────────────────────────────────────────
# Max VMs to create per batch in bulk operations
VM_BULK_BATCH_SIZE=10
# How often to poll Proxmox for async task status (ms)
VM_TASK_POLL_INTERVAL_MS=2000
# Max time to wait for a Proxmox task before timing out (ms)
VM_TASK_TIMEOUT_MS=300000
# Max VMs allowed in a single bulk creation request
VM_MAX_BULK_COUNT=100
# CPU overcommit ratio (4 = allow 4x physical cores to be allocated)
VM_CPU_OVERCOMMIT_RATIO=4
# RAM overcommit ratio (1.5 = allow 1.5x physical RAM to be allocated)
VM_RAM_OVERCOMMIT_RATIO=1.5

# ─── Resource Alert Thresholds (%) ───────────────────────────────────────────
ALERT_CPU_WARNING=70
ALERT_CPU_CRITICAL=85
ALERT_CPU_FULL=95
ALERT_RAM_WARNING=70
ALERT_RAM_CRITICAL=85
ALERT_RAM_FULL=95
ALERT_STORAGE_WARNING=70
ALERT_STORAGE_CRITICAL=85
ALERT_STORAGE_FULL=95

# ─── Monitoring ───────────────────────────────────────────────────────────────
# How often to check node resources for alerts (ms)
NODE_MONITOR_INTERVAL_MS=60000

# ─── Hyper-V / nested virtualization (Windows guests) ─────────────────────────
# Full reference: docs/HYPERV_ENV.md
HYPERV_AGENT_READY_TIMEOUT_MS=300000
HYPERV_EXEC_DEADLINE_MS=1200000
HYPERV_POST_REBOOT_SETTLE_MS=20000
HYPERV_EXEC_POLL_MS=3000
HYPERV_AGENT_POLL_MS=5000
HYPERV_MAX_CONCURRENT=3
HYPERV_SWEEPER_INTERVAL_MS=120000
HYPERV_STUCK_PENDING_MS=300000
HYPERV_STUCK_BUFFER_MS=120000
HYPERV_STUCK_INPROGRESS_MS=300000
HYPERV_MAX_SWEEPER_ATTEMPTS=3
HYPERV_LOCK_LEASE_MS=90000
HYPERV_LOCK_HEARTBEAT_MS=30000
HYPERV_SECOND_REBOOT=true

# ─── Software installation (Windows guests — Chocolatey) ──────────────────────
SOFTWARE_MAX_CONCURRENT=5
SOFTWARE_SWEEPER_INTERVAL_MS=300000
SOFTWARE_STUCK_INSTALLING_MS=1200000
SOFTWARE_STUCK_PENDING_MS=600000
SOFTWARE_MAX_SWEEPER_ATTEMPTS=3
SOFTWARE_QMP_RETRY_DELAY_MS=45000


# ─── Guacamole (browser-based VM console) ─────────────────────────────────────
GUACAMOLE_BASE_URL=http://guac_app:8080/guacamole
GUACAMOLE_PUBLIC_URL=https://dev.racko.ai/guacamole
GUACAMOLE_USERNAME=guacadmin
GUACAMOLE_PASSWORD=guacadmin

# ─── Test VM scaffolding (Phase 4 only) ───────────────────────────────────────
TEST_VM_IP=10.10.10.192
TEST_VM_USERNAME=Administrator
TEST_VM_PASSWORD=admin