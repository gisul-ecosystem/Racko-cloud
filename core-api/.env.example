# MongoDB SRV DNS (optional — use if querySrv ECONNREFUSED on Windows/local dev)
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Tenant branding files cache (logo, favicon, login page image)
TENANT_ASSETS_VOLUME_PATH=./data/tenant-assets

# Razorpay wallet top-up (optional — required for /api/v1/tenant-wallet/topup and /webhooks/razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Super-admin manual wallet credit (offline UPI / bank / cash)
MANUAL_TOPUP_MAX_AMOUNT=500000

# Tenant portal JWT (separate from platform JWT_ACCESS_EXPIRES_IN)
JWT_TENANT_ACCESS_EXPIRES_IN=1d
