<Window x:Class="RackoApp.Views.UploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload &amp; Share File"
        Width="480" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Title -->
      <RowDefinition Height="Auto"/>  <!-- File picker -->
      <RowDefinition Height="Auto"/>  <!-- Permission -->
      <RowDefinition Height="*"/>     <!-- VM list -->
      <RowDefinition Height="Auto"/>  <!-- Buttons -->
    </Grid.RowDefinitions>

    <!-- Title -->
    <TextBlock Grid.Row="0" Text="Upload &amp; Share File"
               FontSize="18" FontWeight="Bold"
               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>

    <!-- File picker -->
    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="File" FontSize="13" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,8">
          <TextBlock x:Name="FileNameText" Text="No file selected"
                     Foreground="{StaticResource TextMuted}" FontSize="13"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Button Grid.Column="1" Content="Browse…"
                Style="{StaticResource SecondaryButton}"
                Margin="8,0,0,0" Click="OnBrowseClick"/>
      </Grid>
    </StackPanel>

    <!-- Permission -->
    <StackPanel Grid.Row="2" Margin="0,0,0,16">
      <TextBlock Text="Permission" FontSize="13" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" x:Name="PermissionPanel">
        <RadioButton x:Name="PermRead"      Content="Read Only"    GroupName="perm" IsChecked="True" Margin="0,0,16,0" FontSize="13"/>
        <RadioButton x:Name="PermReadWrite" Content="Read &amp; Write" GroupName="perm" Margin="0,0,16,0" FontSize="13"/>
        <RadioButton x:Name="PermFull"      Content="Full Control" GroupName="perm" FontSize="13"/>
      </StackPanel>
    </StackPanel>

    <!-- VM list -->
    <StackPanel Grid.Row="3" Margin="0,0,0,16">
      <TextBlock Text="Share with VMs" FontSize="13" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
      <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" MaxHeight="180">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="VmList" Margin="8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" Tag="{Binding Id}"
                          Margin="4,6" FontSize="13" Cursor="Hand"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <TextBlock x:Name="NoVmsText" Text="No other VMs found on your account."
                 FontSize="12" Foreground="{StaticResource TextMuted}"
                 Margin="0,6,0,0" Visibility="Collapsed"/>
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="4" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
              Margin="0,0,10,0" Click="OnCancelClick"/>
      <Button x:Name="UploadBtn" Content="Upload" Style="{StaticResource PrimaryButton}"
              IsEnabled="False" Click="OnUploadClick"/>
    </StackPanel>
  </Grid>
</Window>
