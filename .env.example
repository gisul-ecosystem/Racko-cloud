# ─── Docker / registry ───────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-username

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Use Atlas (recommended for this project) or local docker mongo service:
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=iaas_platform

# Only needed if using the compose mongo service instead of Atlas:
MONGO_ROOT_USER=racko_admin
MONGO_ROOT_PASSWORD=change-me-strong-password

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-64-char-minimum-secret-use-openssl-rand-hex-64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-different-64-char-minimum-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Argon2id ────────────────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Racko Cloud

# ─── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=https://dev.racko.ai
ALLOWED_ORIGINS=https://dev.racko.ai
NEXT_PUBLIC_API_URL=https://api.dev.racko.ai

# ─── Account lockout ───────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# ─── Email verification ────────────────────────────────────────────────────────
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# ─── Super admin seed ──────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-me-strong-password-min-16-chars

# ─── Internal service (gateway ↔ core-api) ─────────────────────────────────────
INTERNAL_SERVICE_SECRET=replace-with-64-char-minimum-internal-service-secret

# ─── Proxmox ───────────────────────────────────────────────────────────────────
PROXMOX_HOST=https://your-proxmox-host:8006
PROXMOX_TOKEN_ID=root@pam!racko-platform
PROXMOX_TOKEN_SECRET=your-proxmox-api-token-secret
PROXMOX_VERIFY_SSL=false
PROXMOX_REQUEST_TIMEOUT_MS=30000

# ─── VM configuration ──────────────────────────────────────────────────────────
VM_BULK_BATCH_SIZE=10
VM_TASK_POLL_INTERVAL_MS=3000
VM_TASK_TIMEOUT_MS=300000
VM_MAX_BULK_COUNT=100
VM_CPU_OVERCOMMIT_RATIO=4
VM_RAM_OVERCOMMIT_RATIO=1.5

# ─── Resource alert thresholds (%) ─────────────────────────────────────────────
ALERT_CPU_WARNING=70
ALERT_CPU_CRITICAL=85
ALERT_CPU_FULL=95
ALERT_RAM_WARNING=70
ALERT_RAM_CRITICAL=85
ALERT_RAM_FULL=95
ALERT_STORAGE_WARNING=70
ALERT_STORAGE_CRITICAL=85
ALERT_STORAGE_FULL=95

# ─── Monitoring ────────────────────────────────────────────────────────────────
NODE_MONITOR_INTERVAL_MS=60000

# ─── Gateway (cloud-gateway reads via env_file; CORE_API_URL set in compose) ───
# JWT_ACCESS_EXPIRES_IN is shared with core-api in this file — override in compose if they differ
REQUEST_TIMEOUT_MS=30000

# ─── GitHub Actions secrets (not used by docker-compose directly) ──────────────
# DOCKERHUB_TOKEN
# VM_HOST
# VM_USER
# VM_SSH_KEY
# SLACK_WEBHOOK_URL
